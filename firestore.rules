rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             data.dailyGoal is int && data.dailyGoal >= 100 && data.dailyGoal <= 200000 &&
             (!('weeklyGoal' in data) || (data.weeklyGoal is int && data.weeklyGoal >= 1000 && data.weeklyGoal <= 1400000)) &&
             (!('totalSteps' in data) || (data.totalSteps is int && data.totalSteps >= 0)) &&
             (!('currentStreak' in data) || (data.currentStreak is int && data.currentStreak >= 0)) &&
             (!('bestStreak' in data) || (data.bestStreak is int && data.bestStreak >= 0)) &&
             (!('connectedWearable' in data) || (data.connectedWearable is string && data.connectedWearable.size() <= 100)) &&
             (!('lastSyncTimestamp' in data) || data.lastSyncTimestamp == null || data.lastSyncTimestamp is timestamp);
    }

    function isValidDailyLog(data) {
      return data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.userId is string && data.userId.size() <= 128 &&
             data.steps is int && data.steps >= 0 && data.steps <= 300000 &&
             data.goal is int && data.goal >= 100 && data.goal <= 200000 &&
             (!('calories' in data) || (data.calories is int && data.calories >= 0 && data.calories <= 50000)) &&
             (!('distanceMeters' in data) || (data.distanceMeters is int && data.distanceMeters >= 0 && data.distanceMeters <= 500000)) &&
             (!('activeMinutes' in data) || (data.activeMinutes is int && data.activeMinutes >= 0 && data.activeMinutes <= 1440)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 100));
    }

    function isValidMilestone(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
             data.requiredSteps is int && data.requiredSteps >= 0 &&
             data.category is string && data.category.size() <= 50 &&
             data.unlocked is bool &&
             (!('unlockedAt' in data) || data.unlockedAt == null || data.unlockedAt is timestamp) &&
             (!('icon' in data) || (data.icon is string && data.icon.size() <= 50));
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.todaySteps is int && data.todaySteps >= 0 && data.todaySteps <= 300000 &&
             data.weeklySteps is int && data.weeklySteps >= 0 && data.weeklySteps <= 2000000 &&
             data.streak is int && data.streak >= 0 &&
             data.level is int && data.level >= 1 && data.level <= 100 &&
             data.badge is string && data.badge.size() <= 100;
    }

    function isValidCloudBackup(data) {
      return data.backupId is string && data.backupId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.backupName is string && data.backupName.size() > 0 && data.backupName.size() <= 100 &&
             data.totalDaysLogged is int && data.totalDaysLogged >= 0 &&
             data.totalStepsLogged is int && data.totalStepsLogged >= 0 &&
             data.summaryJson is string && data.summaryJson.size() <= 500000;
    }

    // 1. User Profile Collection
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false; // PII protection: users cannot list user profiles

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'dailyGoal', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'dailyGoal', 'weeklyGoal', 'totalSteps', 'currentStreak', 'bestStreak', 'connectedWearable', 'lastSyncTimestamp', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'dailyGoal', 'weeklyGoal', 'totalSteps', 'currentStreak', 'bestStreak', 'connectedWearable', 'lastSyncTimestamp', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      // 2. Daily step logs subcollection
      match /daily_logs/{dateKey} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         isValidId(dateKey) &&
                         incoming().keys().hasAll(['date', 'userId', 'steps', 'goal', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['date', 'userId', 'steps', 'goal', 'calories', 'distanceMeters', 'activeMinutes', 'source', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidDailyLog(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidDailyLog(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['steps', 'goal', 'calories', 'distanceMeters', 'activeMinutes', 'source', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // 3. Milestones subcollection
      match /milestones/{milestoneId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         isValidId(milestoneId) &&
                         incoming().keys().hasAll(['id', 'userId', 'title', 'requiredSteps', 'category', 'unlocked', 'updatedAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'title', 'description', 'requiredSteps', 'category', 'unlocked', 'unlockedAt', 'icon', 'updatedAt']) &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidMilestone(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidMilestone(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['unlocked', 'unlockedAt', 'updatedAt', 'title', 'description', 'requiredSteps', 'category', 'icon']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // 4. Cloud Backups subcollection
      match /backups/{backupId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         isValidId(backupId) &&
                         incoming().keys().hasAll(['backupId', 'userId', 'backupName', 'totalDaysLogged', 'totalStepsLogged', 'summaryJson', 'createdAt']) &&
                         incoming().keys().hasOnly(['backupId', 'userId', 'backupName', 'totalDaysLogged', 'totalStepsLogged', 'summaryJson', 'createdAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidCloudBackup(incoming());

        allow update: if false; // Snapshots are immutable
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // 5. Public Social Leaderboard
    match /leaderboard/{userId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'todaySteps', 'weeklySteps', 'streak', 'level', 'badge', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'todaySteps', 'weeklySteps', 'streak', 'level', 'badge', 'updatedAt']) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'todaySteps', 'weeklySteps', 'streak', 'level', 'badge', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
